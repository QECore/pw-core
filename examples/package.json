{
  "name": "pw-core-demo",
  "version": "1.3.0",
  "description": "Demo and example test suite showcasing the usage of pw-core in Playwright.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "test:ui": "playwright test --ui",
    "codegen": "npx pw-core codegen",
    "codegen:safe": "npx pw-core codegen --safe",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "author": {
    "name": "Shanmuka Chandra Teja Anem",
    "url": "https://github.com/shanmukaanem"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^20.11.0",
    "dotenv": "^16.4.5",
    "eslint": "^10.6.0",
    "pw-core": "file:..",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1"
  }
}